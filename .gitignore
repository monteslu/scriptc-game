node_modules/
vendor/
build/
.scriptc/
*.tmp
*.o
*.a
*.ll

# Spike SOURCES are kept (const-ffi-repro.ts documents a real compiler bug
# and threadtest.ts is the audio-thread evidence); build products are not.
# scriptc names a binary after its entry file with the extension dropped,
# so every spike binary is an extensionless file at the spike/ root.
spike/*
!spike/*.ts
!spike/*.json
# Spike WRITE-UPS are the point of the spikes: the measurements and the
# decisions they settled outlive the throwaway code that produced them.
!spike/*.md
!spike/ffi/
spike/ffi/*
!spike/ffi/*.c
!spike/ffi/*.json

# Conformance output and goldens: both are REGENERATED (build/conformance and
# test/golden/render-goldens.mjs), and committing PNGs would turn every Skia
# bump into a binary-diff review.
test/out/
test/golden/png/

# Example assets (art, music) ARE committed: an example that cannot run from
# a fresh clone is not an example. Test FIXTURES are generated instead --
# see scripts/make-decode-fixtures.sh.
test/fixtures/images/

# Generated per-build entry modules: gen-entry.js writes these, and they
# bake in an absolute game directory. Never committed.
.sg-build/

# The browser proof's build output and captures: both regenerate from
# browser/build.sh, and the shots are large PNGs of the same two frames.
browser/out/
browser/shots/

# Baked mesh fixtures: regenerated by scripts/mesh-fixtures.sh from the
# .obj/.glb sources beside them, so committing them would let a stale
# fixture pass against a loader that no longer matches the baker.
test/mesh-fixtures/*.sgm

# Baked meshes: regenerated from the .obj sources in examples/shared/ by
# codegen/bake-mesh.js, so a stale one cannot pass against a changed baker.
examples/*/public/*.sgm

# Box3D upstream checkout (scripts/build-box3d.sh fetches at the pinned
# SHA; versions.json is the record, the clone is disposable).
.deps/
